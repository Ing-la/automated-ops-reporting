# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
build/
dist/

# 虚拟环境
env/
venv/
ENV/
.venv/

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# 环境变量和配置（包含敏感信息）
.env
.env.local
.env.*.local

# 例外：允许.env.example示例文件
!.env.example

# 数据文件（不纳入版本控制）
data/raw/*
!data/raw/.gitkeep
*.xlsx
*.xls
*.csv

# 例外：允许data-demo目录下的演示数据
!data-demo/*.xlsx
!data-demo/*.xls

# snapshot目录：保留目录结构，但忽略CSV文件（如果需要的话）
# 注意：snapshot CSV文件通常需要版本控制，所以这里不忽略
# data/snapshot/*.csv

# history目录：保留目录结构，但忽略内容
data/history/*
!data/history/.gitkeep

# 输出文件：保留目录结构，但忽略内容
output/*
!output/.gitkeep

# 日志文件
*.log

# 临时文件
*.tmp
*.bak
*~

